XRAY_PATH=bin/xray
CONCURRENCY=10
STARTUP_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=15000
GATEWAY_REQUEST_TIMEOUT_MS=45000
GATEWAY_CONCURRENCY=3
GEOIP_TIMEOUT_MS=5000
FETCH_TIMEOUT_MS=60000
FETCH_MAX_RETRIES=3
FETCH_RETRY_DELAY_MS=2000
MAX_RETRIES=1
IP_CHECK_URL=https://api.ipify.org?format=json
GEOIP_URL=http://ip-api.com/json
CONFIGS_FILE=configs.txt
# Russian gateway source (default: v2nodes RU subscription)
# Profiles: v2nodes (default), black_vless, black_vless_mobile, white_vless_mobile
RUSSIA_PROFILE=v2nodes
# V2NODES_MAX_PAGES=10  # max pages for subscription + country list
# RUSSIA_SUB_URL=  # override profile with a custom subscription URL

# Telegram (optional) — publishes healthy non-Russian configs
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override Xray release used by scripts/install-xray.sh
# XRAY_VERSION=26.7.28
